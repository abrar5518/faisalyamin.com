generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING           // Order placed, awaiting confirmation
  PAID              // Legacy: Payment received (use CONFIRMED instead)
  CONFIRMED         // Order confirmed by admin
  PROCESSING        // Order is being prepared
  READY_TO_SHIP     // Order packed and ready
  SHIPPED           // Order handed to courier
  OUT_FOR_DELIVERY  // Out for delivery
  DELIVERED         // Successfully delivered
  CANCELLED         // Order cancelled
  REFUNDED          // Order refunded
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String?
  descriptionHtml String?     @db.LongText
  image         String?
  imageAlt      String?       @db.Text
  metaTitle     String?       @db.Text
  metaDescription String?     @db.Text
  metaKeywords  String?       @db.Text
  subcategories Subcategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String    @unique
  description String?
  descriptionHtml String? @db.LongText
  image       String?
  imageAlt    String?   @db.Text
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String? @db.Text

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model Product {
  id              Int           @id @default(autoincrement())
  categoryId      Int
  subcategoryId   Int?

  name            String
  slug            String        @unique

  price           Decimal       @db.Decimal(12, 2)
  compareAt       Decimal?      @db.Decimal(12, 2)
  badge           String?

  rating          Float         @default(0)
  reviewsCount    Int           @default(0)

  shortDesc       String?
  descriptionHtml String        @db.LongText
  sizes           Json?
  variants        Json?

  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isSale          Boolean       @default(false)

  metaKeywords    String?       @db.Text
  metaTitle       String?       @db.Text
  metaDescription String?       @db.Text
  indexable       Boolean       @default(true)

  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  orderItems      OrderItem[]
  wishlistedBy    WishlistItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
}


model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?  @db.Text
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  coverImage  String?
  coverAlt    String?   @db.Text
  contentHtml String    @db.LongText
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String?  @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Page {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  contentHtml String?   @db.LongText
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String?  @db.Text
  shortDescription String? @db.Text
  featureImage String? @db.Text
  featureImageAlt String? @db.Text

  heroBadge   String?
  heroTitle   String?   @db.Text
  heroSubtitle String?  @db.Text
  heroPrimaryLabel String?
  heroPrimaryHref  String?
  heroSecondaryLabel String?
  heroSecondaryHref String?
  heroImage  String?    @db.Text
  heroImageAlt String?  @db.Text
  heroCardTitle String?
  heroCardSubtitle String? @db.Text
  heroCardPrimaryLabel String?
  heroCardPrimaryHref  String?
  heroCardSecondaryLabel String?
  heroCardSecondaryHref String?

  heroHighlight1Title String?
  heroHighlight1Desc  String? @db.Text
  heroHighlight2Title String?
  heroHighlight2Desc  String? @db.Text
  heroHighlight3Title String?
  heroHighlight3Desc  String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?

  address1  String?
  address2  String?
  city      String?
  state     String?
  country   String?
  postal    String?

  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int
  status        OrderStatus @default(PENDING)

  subtotal      Decimal     @db.Decimal(12, 2)
  shipping      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paymentMethod String?

  // Tracking & Delivery
  trackingId    String?     // Courier tracking ID
  courierName   String?     // e.g., "TCS", "Leopards", "PostEx"
  estimatedDelivery DateTime? // Estimated delivery date
  deliveredAt   DateTime?   // Actual delivery date
  
  // Admin notes
  adminNotes    String?     @db.Text

  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  productId       Int
  qty             Int
  priceAtPurchase Decimal  @db.Decimal(12, 2)
  variantLabel    String?
  sizeLabel       String?

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  profile      UserProfile?
  settings     UserSettings?
  sessions     Session[]
  addresses    AccountAddress[]
  wishlist     WishlistItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique
  userAgent  String?  @db.Text
  ip         String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  firstName String
  lastName  String
  phone     String?
  country   String?
  city      String?
  company   String?
  notes     String? @db.Text

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id               Int     @id @default(autoincrement())
  userId           Int     @unique
  emailOffers      Boolean @default(true)
  emailOrderUpdates Boolean @default(true)
  whatsappUpdates  Boolean @default(false)
  currency         String? @db.VarChar(10)
  language         String? @db.VarChar(30)
  timezone         String? @db.VarChar(40)

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String?
  fullName   String
  phone      String?
  address1   String
  address2   String?
  city       String
  state      String?
  country    String
  postalCode String?
  notes      String?  @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contact {
  id             Int      @id @default(autoincrement())
  phone          String?
  whatsapp       String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  hoursWeekdays  String?
  hoursWeekend   String?
  notes          String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSettings {
  id          Int      @id @default(autoincrement())
  siteName    String?
  siteUrl     String?  @db.Text
  logoUrl     String?  @db.Text
  logoAlt     String?  @db.Text
  siteIconUrl String?  @db.Text
  siteIconAlt String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreSettings {
  id                    Int      @id @default(autoincrement())
  storeName             String?
  storeDomain           String?
  freeShippingThreshold String?
  defaultShippingFee    String?
  returnsDays           Int?
  codEnabled            Boolean  @default(true)
  cardEnabled           Boolean  @default(true)
  gatewayName           String?
  cryptoEnabled         Boolean  @default(false)
  siteTitle             String?
  siteMetaDesc          String?
  indexable             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
