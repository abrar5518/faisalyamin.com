generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING           // Order placed, awaiting confirmation
  PAID              // Legacy: Payment received (use CONFIRMED instead)
  CONFIRMED         // Order confirmed by admin
  PROCESSING        // Order is being prepared
  READY_TO_SHIP     // Order packed and ready
  SHIPPED           // Order handed to courier
  OUT_FOR_DELIVERY  // Out for delivery
  DELIVERED         // Successfully delivered
  CANCELLED         // Order cancelled
  REFUNDED          // Order refunded
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  description   String?
  descriptionHtml String?     @db.LongText
  image         String?
  imageAlt      String?       @db.Text
  isFeatured    Boolean       @default(false)
  metaTitle     String?       @db.Text
  metaDescription String?     @db.Text
  metaKeywords  String?       @db.Text
  faqItems      CategoryFaqItem[]
  subcategories Subcategory[]
  products      Product[]
  productCategories ProductCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  slug        String    @unique
  description String?
  descriptionHtml String? @db.LongText
  image       String?
  imageAlt    String?   @db.Text
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String? @db.Text
  faqItems    SubcategoryFaqItem[]

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]
  productSubcategories ProductSubcategory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model Product {
  id              Int           @id @default(autoincrement())
  categoryId      Int
  subcategoryId   Int?

  name            String
  slug            String        @unique
  brand           String?

  price           Decimal       @db.Decimal(12, 2)
  compareAt       Decimal?      @db.Decimal(12, 2)
  badge           String?

  rating          Float         @default(0)
  reviewsCount    Int           @default(0)

  shortDesc       String?
  descriptionHtml String        @db.LongText
  sizes           Json?
  variants        Json?

  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isSale          Boolean       @default(false)

  metaKeywords    String?       @db.Text
  metaTitle       String?       @db.Text
  metaDescription String?       @db.Text
  indexable       Boolean       @default(true)

  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  productCategories ProductCategory[]
  productSubcategories ProductSubcategory[]

  images          ProductImage[]
  orderItems      OrderItem[]
  wishlistedBy    WishlistItem[]
  reviews         ProductReview[]
  blogProducts    BlogProduct[]
  faqItems        ProductFaqItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
}

model ProductSubcategory {
  id            Int         @id @default(autoincrement())
  productId     Int
  subcategoryId Int
  createdAt     DateTime    @default(now())

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, subcategoryId])
  @@index([subcategoryId])
  @@index([productId])
}

model CategoryFaqItem {
  id         Int      @id @default(autoincrement())
  categoryId Int
  question   String
  answer     String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model SubcategoryFaqItem {
  id            Int         @id @default(autoincrement())
  subcategoryId Int
  question      String
  answer        String?     @db.Text
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@index([subcategoryId])
}

model ProductFaqItem {
  id        Int      @id @default(autoincrement())
  productId Int
  question  String
  answer    String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model BlogFaqItem {
  id        Int      @id @default(autoincrement())
  blogId    Int
  question  String
  answer    String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

enum BlogProductPlacement {
  TOP
  MIDDLE
  BOTTOM
}

model BlogProduct {
  id        Int                  @id @default(autoincrement())
  blogId    Int
  productId Int
  placement BlogProductPlacement @default(MIDDLE)
  sortOrder Int                  @default(0)

  blog      Blog                 @relation(fields: [blogId], references: [id], onDelete: Cascade)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime             @default(now())

  @@unique([blogId, productId])
  @@index([blogId])
  @@index([productId])
}


model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?  @db.Text
  mediaType String   @default("image")
  thumbnailUrl String? @db.Text
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  coverImage  String?
  coverAlt    String?   @db.Text
  contentHtml String    @db.LongText
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String?  @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  blogProducts BlogProduct[]
  faqItems     BlogFaqItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogAuthor {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  role        String?
  avatar      String?   @db.Text
  bioHtml     String?   @db.LongText
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String?  @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Page {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  contentHtml String?   @db.LongText
  metaTitle   String?   @db.Text
  metaDescription String? @db.Text
  metaKeywords String?  @db.Text
  shortDescription String? @db.Text
  featureImage String? @db.Text
  featureImageAlt String? @db.Text

  heroBadge   String?
  heroTitle   String?   @db.Text
  heroSubtitle String?  @db.Text
  heroPrimaryLabel String?
  heroPrimaryHref  String?
  heroSecondaryLabel String?
  heroSecondaryHref String?
  heroImage  String?    @db.Text
  heroImageAlt String?  @db.Text
  heroCardTitle String?
  heroCardSubtitle String? @db.Text
  heroCardPrimaryLabel String?
  heroCardPrimaryHref  String?
  heroCardSecondaryLabel String?
  heroCardSecondaryHref String?

  heroHighlight1Title String?
  heroHighlight1Desc  String? @db.Text
  heroHighlight2Title String?
  heroHighlight2Desc  String? @db.Text
  heroHighlight3Title String?
  heroHighlight3Desc  String? @db.Text

  homeIntroTitle String?
  homeIntroBody  String? @db.Text
  homeBenefitsTitle String?
  homeBenefitsIntro String? @db.Text
  homeFaqTitle String?
  homeFaqIntro String? @db.Text
  homeSaleLimit Int?
  homeSaleVisibleCount Float?
  homeSaleAutoMs Int?

  aboutPage  AboutPage?
  homeBenefits HomeBenefitItem[]
  homeFaqItems HomeFaqItem[]
  homeTestimonials HomeTestimonial[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AboutPage {
  id          Int       @id @default(autoincrement())
  pageId      Int       @unique
  breadcrumbLabel String?
  heroNoteHtml String?  @db.Text

  storyTitle  String?
  storyIntro  String?   @db.Text
  storyPrimaryLabel String?
  storyPrimaryHref  String?
  storySecondaryLabel String?
  storySecondaryHref String?
  storyBodyHtml String? @db.LongText

  valuesTitle String?
  valuesIntro String?   @db.Text
  valuesAssistTitle String?
  valuesAssistDesc String? @db.Text
  valuesAssistCtaLabel String?
  valuesAssistCtaHref  String?

  verificationTitle String?
  verificationIntro String? @db.Text
  verificationSupportLabel String?
  verificationSupportHref  String?
  verificationMoreHtml String? @db.Text

  supportTitle String?
  supportIntro String? @db.Text
  supportLinkLabel String?
  supportLinkHref  String?

  faqTitle String?
  faqIntro String? @db.Text
  faqLinkLabel String?
  faqLinkHref  String?
  faqFooterHtml String? @db.Text

  finalCtaTitle String?
  finalCtaDesc  String? @db.Text
  finalCtaPrimaryLabel String?
  finalCtaPrimaryHref  String?
  finalCtaSecondaryLabel String?
  finalCtaSecondaryHref  String?

  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  stats       AboutStat[]
  heroChips   AboutHeroChip[]
  heroInfoCards AboutHeroInfoCard[]
  valuesItems AboutValueItem[]
  verificationSteps AboutVerificationStep[]
  supportLinks AboutSupportLink[]
  supportCards AboutSupportCard[]
  faqItems    AboutFaqItem[]
  finalCtaLinks AboutFooterLink[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AboutStat {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  label       String
  value       String
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutHeroChip {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  label       String
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutHeroInfoCard {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  title       String
  bodyHtml    String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutValueItem {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  title       String
  desc        String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutVerificationStep {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  stepLabel   String
  title       String
  desc        String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutSupportLink {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  href        String
  title       String
  desc        String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutSupportCard {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  title       String
  bodyHtml    String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutFaqItem {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  question    String
  answer      String?  @db.Text
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model AboutFooterLink {
  id          Int      @id @default(autoincrement())
  aboutPageId Int
  label       String
  href        String
  sortOrder   Int      @default(0)

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
}

model HomeFaqItem {
  id        Int      @id @default(autoincrement())
  pageId    Int
  question  String
  answer    String?  @db.Text
  sortOrder Int      @default(0)

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model HomeBenefitItem {
  id        Int      @id @default(autoincrement())
  pageId    Int
  title     String
  desc      String?  @db.Text
  sortOrder Int      @default(0)

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model HomeTestimonial {
  id        Int      @id @default(autoincrement())
  pageId    Int
  name      String
  title     String?
  quote     String?  @db.Text
  avatarUrl String?  @db.Text
  rating    Float    @default(5)
  sortOrder Int      @default(0)

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  loyaltyPoints Int  @default(0)

  address1  String?
  address2  String?
  city      String?
  state     String?
  country   String?
  postal    String?

  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int
  status        OrderStatus @default(PENDING)

  subtotal      Decimal     @db.Decimal(12, 2)
  shipping      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @db.Decimal(12, 2) @default(0)
  loyaltyDiscount Decimal   @db.Decimal(12, 2) @default(0)
  loyaltyPointsRedeemed Int @default(0)
  loyaltyPointsEarned Int   @default(0)
  total         Decimal     @db.Decimal(12, 2)
  paymentMethod String?
  couponCode    String?

  // Tracking & Delivery
  trackingId    String?     // Courier tracking ID
  courierName   String?     // e.g., "TCS", "Leopards", "PostEx"
  estimatedDelivery DateTime? // Estimated delivery date
  deliveredAt   DateTime?   // Actual delivery date
  
  // Admin notes
  adminNotes    String?     @db.Text

  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([couponCode])
}

model LoyaltySettings {
  id               Int      @id @default(autoincrement())
  enabled          Boolean  @default(true)
  pointsPerCurrency Decimal @db.Decimal(12, 4) @default(0.01) // 1 point per 100 currency
  currencyPerPoint  Decimal @db.Decimal(12, 4) @default(0.05) // 100 points = 5 currency
  minRedeemPoints  Int      @default(100)
  maxRedeemPercent Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Coupon {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  description      String?    @db.Text
  type             CouponType @default(PERCENT)
  value            Decimal    @db.Decimal(12, 2)
  minSubtotal      Decimal?   @db.Decimal(12, 2)
  maxDiscount      Decimal?   @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  productId       Int
  qty             Int
  priceAtPurchase Decimal  @db.Decimal(12, 2)
  variantLabel    String?
  sizeLabel       String?

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  profile      UserProfile?
  settings     UserSettings?
  sessions     Session[]
  addresses    AccountAddress[]
  wishlist     WishlistItem[]
  reviews      ProductReview[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductReview {
  id         Int          @id @default(autoincrement())
  productId  Int
  userId     Int
  rating     Int
  title      String?      @db.Text
  body       String       @db.LongText
  status     ReviewStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  images     ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId])
}

model ReviewImage {
  id        Int           @id @default(autoincrement())
  reviewId  Int
  url       String
  alt       String?       @db.Text
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique
  userAgent  String?  @db.Text
  ip         String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  firstName String
  lastName  String
  phone     String?
  country   String?
  city      String?
  company   String?
  notes     String? @db.Text

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id               Int     @id @default(autoincrement())
  userId           Int     @unique
  emailOffers      Boolean @default(true)
  emailOrderUpdates Boolean @default(true)
  whatsappUpdates  Boolean @default(false)
  currency         String? @db.VarChar(10)
  language         String? @db.VarChar(30)
  timezone         String? @db.VarChar(40)

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String?
  fullName   String
  phone      String?
  address1   String
  address2   String?
  city       String
  state      String?
  country    String
  postalCode String?
  notes      String?  @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contact {
  id             Int      @id @default(autoincrement())
  phone          String?
  whatsapp       String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  hoursWeekdays  String?
  hoursWeekend   String?
  notes          String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSettings {
    id          Int      @id @default(autoincrement())
    siteName    String?
    siteUrl     String?  @db.Text
    logoUrl     String?  @db.Text
    logoAlt     String?  @db.Text
    siteIconUrl String?  @db.Text
    siteIconAlt String?  @db.Text
    siteFooterText String? @db.Text
    metaPixelIds String? @db.Text
    facebookDomainVerification String? @db.Text
    googleSiteVerification String? @db.Text
    googleTagManagerId String? @db.Text
    microsoftClarityId String? @db.Text
    customHeadScripts String? @db.LongText
    customBodyStartScripts String? @db.LongText
    customBodyEndScripts String? @db.LongText
    headerMenuItems String? @db.Text
    headerSearchPlaceholder String? @db.Text
    headerAnnouncementEnabled Boolean @default(true)
    headerAnnouncementText String? @db.Text
    headerAnnouncementHref String? @db.Text
    headerShowSearch Boolean @default(true)
    headerShowAccount Boolean @default(true)
    headerShowCart Boolean @default(true)
    headerShowSupportLinks Boolean @default(true)
    footerCopyright String? @db.Text
    footerColumns String? @db.Text
    footerNewsletterEnabled Boolean @default(true)
    footerNewsletterEyebrow String? @db.Text
    footerNewsletterTitle String? @db.Text
    footerNewsletterSubtitle String? @db.Text
    footerNewsletterConsentText String? @db.Text
    footerTrustItems String? @db.Text
    footerSocialLinks String? @db.Text
    metaPixelEnabled Boolean @default(true)
    googleTagManagerEnabled Boolean @default(true)
    microsoftClarityEnabled Boolean @default(true)
    customHeadScriptsEnabled Boolean @default(true)
    customBodyStartScriptsEnabled Boolean @default(true)
    customBodyEndScriptsEnabled Boolean @default(true)
    themeSettings String? @db.LongText
    globalCopy String? @db.LongText
    checkoutSettings String? @db.LongText
    cartSettings String? @db.LongText
    catalogSettings String? @db.LongText
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
  }

model StoreSettings {
  id                    Int      @id @default(autoincrement())
  storeName             String?
  storeDomain           String?
  freeShippingThreshold String?
  defaultShippingFee    String?
  returnsDays           Int?
  codEnabled            Boolean  @default(true)
  cardEnabled           Boolean  @default(true)
  gatewayName           String?
  cryptoEnabled         Boolean  @default(false)
  siteTitle             String?
  siteMetaDesc          String?
  indexable             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RedirectRule {
  id          Int      @id @default(autoincrement())
  source      String   @unique @db.VarChar(512)
  destination String   @db.VarChar(512)
  permanent   Boolean  @default(true)
  isActive    Boolean  @default(true)
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReusableBlock {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  type           String   @default("trust")
  placement      String   @default("general")
  eyebrow        String?
  bodyHtml       String?  @db.LongText
  icon           String?
  primaryLabel   String?
  primaryHref    String?
  secondaryLabel String?
  secondaryHref  String?
  itemsJson      String?  @db.LongText
  isEnabled      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([placement])
  @@index([isEnabled])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  source    String?  @db.Text
  ip        String?  @db.Text
  userAgent String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
